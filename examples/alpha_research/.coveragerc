[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    raise ImportError
    pass
precision = 2
show_missing = True
fail_under = 90

[html]
directory = htmlcov
