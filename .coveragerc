[run]
source = .
omit =
    */tests/*
    */test_*
    *_test.py
    */venv/*
    */env/*
    */virtualenv/*
    .tox/*
    .eggs/*
    *.egg-info/*
    build/*
    dist/*
    docs/*
    examples/*
    scripts/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
precision = 2
show_missing = True

[html]
directory = htmlcov
